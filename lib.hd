#!/bin/bash

hd_glob_var_init()
{
	NAMESPACE=${NAMESPACE:-default}
	STORAGE_CLASS=${STORAGE_CLASS:-local-path}
}

hd_manage_vars()
{
	set -a
	if [ "function" = "$(type -t hd_var_defaults)" ]
	then
		hd_var_defaults
	fi

	hd_glob_var_init

	set +a
}

kns()
{
	k get ns $1 > /dev/null || k create namespace $1
}

hd_apply_config()
{
	# ensure namespace created
	kns $NAMESPACE
	
	if [ ! -z "$HD_STRICT" ]
	then
		set -e
		trap 'rm -rf $HD_KUSTOMISATION_DIR' exit
	fi

	# if no customization set, run the plain method
	if [ -z $KUST ]
	then
		cat $HD_UNIT_DIR/$1 | envsubst | k apply -f -
		return
	fi

	export HD_KUSTOMISATION_DIR=$(mktemp -d)
	export HD_KUSTOMISATION_FILE="${HD_KUSTOMISATION_DIR}/patch.yaml"
	:> $HD_KUSTOMISATION_FILE

	cat $HD_UNIT_DIR/$1 | envsubst > "$HD_KUSTOMISATION_DIR/base.yaml"

	cat <<EOF > "$HD_KUSTOMISATION_DIR/kustomization.yaml"
resources:
  - base.yaml
patches:
  - path: patch.yaml
EOF

    for KST in $KUST
    do
		if declare -f "kust_$KST" > /dev/null; then
			"kust_$KST"
		else
			if [ -z "$HD_STRICT" ]
			then
				echo "Warning: Customizer 'kust_$KST' does not exists" >&2
			else
				echo "ERROR: Customizer 'kust_$KST' does not exists" >&2
				exit 1
			fi
		fi
	done

	# in strict mode, run anyaway (and let fail)
	if [ ! -z "$HD_STRICT" ] || [ -s $HD_KUSTOMISATION_FILE ]
	then
		k kustomize "$HD_KUSTOMISATION_DIR" | k apply -f -

	else # in non strict way patch may be empty and run the apply only
		cat $HD_UNIT_DIR/$1 | envsubst | k apply -f -
	fi

	rm -rf "$HD_KUSTOMISATION_DIR"
	trap '' exit
}

hd_env_apply_config()
{
	hd_manage_vars
	hd_apply_config $1
}

